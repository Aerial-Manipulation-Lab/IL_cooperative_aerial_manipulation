# Copy this into run/slurm.env or run/local.env. run.sh sources exactly one of them,
# picked by the target you pass: `./run.sh slurm` or `./run.sh local`.
#
# SIF             - path to the apptainer .sif image to run the job in.
# REPO            - absolute path to your checkout of IL_cooperative_aerial_manipulation_ext.
# ASSETS          - path to a shared/cloud Isaac asset root, if you want to
#                    override the default asset source (leave ASSET_ARGS empty to skip).
# SLURM_MAIL_USER - email for job notifications (slurm target only).
# SCRIPT_REL      - path, relative to REPO, of the python script to run.
# EXT_PYTHONPATH  - PYTHONPATH set inside the container, so the extension is importable.
# ASSET_ARGS      - extra --kit_args passed to isaaclab.sh for the ASSETS override; empty string to skip.
# BIND_ARGS       - bash array of extra `-B host:container` apptainer bind mounts.

SIF=/path/to/isaac-lab.sif
REPO=/path/to/your/checkout/IL_cooperative_aerial_manipulation_ext
ASSETS=/path/to/shared/isaac_assets
SLURM_MAIL_USER=you@example.com

SCRIPT_REL=scripts/MARL_mav_carry/testing_scripts/flycrane_env_play_llc.py
EXT_PYTHONPATH="$REPO/exts/MARL_mav_carry_ext"

ASSET_ARGS="--kit_args=--/persistent/isaac/asset_root/cloud=$ASSETS"
BIND_ARGS=()
